# SadQah environment. Copy to `.env` (backend reads it from its working directory) and fill in.
# Nothing in this file is a real secret. Generate real ones with:  python backend/scripts/generate_secrets.py
# In ENV=dev, missing secrets fall back to publicly known development values. ENV=staging|prod refuses to start without real ones.

# ---- general -------------------------------------------------------------------------------
ENV=dev
APP_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
TRUSTED_PROXY_COUNT=0
LOG_LEVEL=INFO
REDIS_URL=redis://localhost:6379/0

# ---- database: one least-privilege login per service (passwords chosen when you run database/roles.sql) -------
DB_API_PASSWORD=change-me-api
DB_WORKER_PASSWORD=change-me-worker
DB_WEBHOOK_PASSWORD=change-me-webhook
DB_KYC_PASSWORD=change-me-kyc
DB_ADMIN_PASSWORD=change-me-admin
DATABASE_URL_API=postgresql://sadqah_api:change-me-api@localhost:5432/sadqah
DATABASE_URL_WORKER=postgresql://sadqah_worker:change-me-worker@localhost:5432/sadqah
DATABASE_URL_WEBHOOK=postgresql://sadqah_webhook:change-me-webhook@localhost:5432/sadqah
DATABASE_URL_KYC=postgresql://sadqah_kyc:change-me-kyc@localhost:5432/sadqah
DATABASE_URL_ADMIN=postgresql://sadqah_admin:change-me-admin@localhost:5432/sadqah

# ---- secrets (generate; never commit real values) --------------------------------------------
# ENCRYPTION_KEYS="v1:<base64 of 32 random bytes>"  (add v2:... when rotating, then set ACTIVE_KEY_ID=v2)
ENCRYPTION_KEYS=
ACTIVE_KEY_ID=v1
# base64 of 32 random bytes. Rotating requires re-indexing e-mail/phone/NIC blind indexes.
BLIND_INDEX_KEY=
# base64 of 32 random bytes. Rotating invalidates every anonymous Donation Token.
TOKEN_PEPPER=
# random string, at least 32 characters
JWT_SECRET=
SESSION_TTL_MINUTES=720
STAFF_SESSION_TTL_MINUTES=60

# ---- PayPal (SANDBOX; see docs/PAYPAL_SANDBOX_SETUP.md) ----------------------------------------
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_TIMEOUT_SECONDS=20

# ---- donations -----------------------------------------------------------------------------
MIN_DONATION_CENTS=100
MAX_DONATION_CENTS=50000
DONATION_PRESETS_CENTS=500,1000,2500,5000

# ---- payout batching -----------------------------------------------------------------------
PAYOUT_MAX_ITEMS_PER_BATCH=500
PAYOUT_MIN_ITEMS_TO_FIRE=25
PAYOUT_MAX_WAIT_SECONDS=900
PAYOUT_POLL_SECONDS=20
PAYOUT_MAX_ATTEMPTS=6
PAYOUT_EMAIL_SUBJECT=You have received a SadQah micro-grant
PAYOUT_EMAIL_MESSAGE=A supporter of SadQah has sent you a small grant to help your business. If you do not have a PayPal account yet, follow the link in this message to create one and claim it.
RECONCILE_STALE_AFTER_SECONDS=900

# ---- Password recovery (one-time codes by e-mail) -------------------------------------------
# Leave SMTP_HOST empty and recovery is switched off: the site says so instead of pretending to send. Use any SMTP service
# you control or pay for; these are placeholders, put the real values only in your private .env.
SMTP_HOST=
SMTP_PORT=587
# SMTP_SECURITY: starttls (port 587), ssl (port 465) or none (dev only; refused outside dev)
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=SadQah <no-reply@example.invalid>
SMTP_TIMEOUT_SECONDS=10
# How long a code works, in seconds (60 to 3600)
RECOVERY_CODE_TTL_SECONDS=900
# Text-message recovery stays off: no provider is built in
SMS_PROVIDER=none

# ---- KYC and AI assessment -------------------------------------------------------------------
# Without a key the pipeline leaves every case for a human reviewer. The AI only recommends.
ANTHROPIC_API_KEY=
KYC_LLM_MODEL=claude-sonnet-5-5
KYC_LLM_MAX_TOKENS=2000
# The help assistant, the price check and the needs-proof check use the engine chosen by ASSISTANT_PROVIDER:
#   anthropic = the original behaviour, needs ANTHROPIC_API_KEY (default)
#   ollama    = a local model on your own machine (text only), no paid request; set the OLLAMA_* lines below
#   none      = built-in FAQ only
# The choice is explicit: if the chosen engine is down the assistant answers from the FAQ, it never switches engines by itself.
# Only "anthropic" can look at an uploaded proof photo or PDF; with "ollama" the proof is marked "not checked" for a human reviewer.
# Without a working engine every needs list goes to a human reviewer unchecked. ASSISTANT_LLM_MODEL (empty = use KYC_LLM_MODEL) is for anthropic only.
ASSISTANT_PROVIDER=anthropic
ASSISTANT_LLM_MODEL=
ASSISTANT_MAX_TOKENS=1500
# Ollama (used only when ASSISTANT_PROVIDER=ollama). From the API container, the host's Ollama is host.docker.internal. Do NOT expose Ollama publicly.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_NUM_CTX=4096
# Speed and load on a CPU-only machine (all optional; these are the defaults):
# OLLAMA_MAX_TOKENS caps a chat reply; OLLAMA_KEEP_ALIVE keeps the model loaded between questions; OLLAMA_MAX_CONCURRENT model calls
# run at once and OLLAMA_MAX_QUEUE more may wait (extra requests get an honest "could not answer just now", not a pile-up);
# OLLAMA_NUM_THREAD (empty = Ollama decides) lets you leave CPU cores free for the website; ASSISTANT_HISTORY_* bound the chat history sent.
OLLAMA_MAX_TOKENS=400
OLLAMA_KEEP_ALIVE=30m
OLLAMA_MAX_CONCURRENT=1
OLLAMA_MAX_QUEUE=2
OLLAMA_NUM_THREAD=
ASSISTANT_HISTORY_MESSAGES=6
ASSISTANT_HISTORY_CHARS=3000
KYC_FACE_PROVIDER=none
KYC_FACE_MIN_SCORE=0.85
KYC_DISTRESS_THRESHOLD_CENTS=5000
KYC_ALLOCATION_MIN_CENTS=5000
KYC_ALLOCATION_MAX_CENTS=50000
KYC_TARGET_MONTHLY_INCOME_CENTS=12000
KYC_MAX_PAYBACK_MONTHS=12
KYC_POLL_SECONDS=10
# FX_RATES_JSON={"USD":1.0,"PKR":0.0036}
# Reviewer account the automated message moderator acts as (a user id; optional)
SYSTEM_MODERATOR_USER_ID=

# ---- file storage ----------------------------------------------------------------------------
STORAGE_BACKEND=local
VAULT_DIR=./var/vault
PUBLIC_MEDIA_DIR=./var/public_media
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
CLAMAV_HOST=
CLAMAV_PORT=3310
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=40000000

# ---- frontend (frontend/.env.local) -------------------------------------------------------------
# Where Next.js rewrites /api/* to
BACKEND_URL=http://localhost:8000
